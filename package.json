{
  "name": "live-session-cap-from-development-to-deployment",
  "version": "1.0.0",
  "description": "SAP CAP Live Session: From Development to Deployment",
  "repository": "https://github.com/clouddnagmbh/live-session-CAP-From-Development-To-Deployment",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^10",
    "express": "^4",
    "@cap-js/hana": "^3",
    "@sap/xssec": "^4"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-products": "cds watch --open products/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "sapux": [
    "app/products"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-runtime": true,
      "workzone": true
    }
  }
}
